# Required
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/gachchini?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Cloudinary image storage (required for hosted uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# PlantNet is the primary botanical identification provider
PLANTNET_API_KEY=your_plantnet_api_key
PLANTNET_PROJECT=all

# Gemini provides an independent vision opinion / fallback, not the sole authority
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Optional controls
APP_ORIGIN=http://localhost:5173
API_BASE_URL=http://localhost:5000
JWT_EXPIRES_IN=7d

# Optional: first admin account created by `npm run seed`
ADMIN_NAME=GachChini Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_a_strong_password_12_chars_minimum
MAX_UPLOAD_MB=8
IDENTIFY_MIN_CONFIDENCE=0.35
